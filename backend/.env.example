APP_NAME=PaperMind Agent API
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./data/papermind.db
STORAGE_DIR=../storage
MINERU_ROOT=../.mineru
MINERU_FORMULA_ENABLED=true
MINERU_FORMULA_TIMEOUT_SECONDS=30
MINERU_FIGURE_ENABLED=true
MINERU_FIGURE_SERVICE_URL=http://127.0.0.1:8002
MINERU_FIGURE_STARTUP_TIMEOUT_SECONDS=180
MINERU_FIGURE_REQUEST_TIMEOUT_SECONDS=120
MINERU_FIGURE_IDLE_TIMEOUT_SECONDS=15
MINERU_FIGURE_MODEL_ID=OpenDataLab/MinerU2.5-Pro-2605-1.2B
MINERU_FIGURE_REVISION=
MINERU_FIGURE_PYTHON=../.mineru/figure-env/Scripts/python.exe
MINERU_FIGURE_MANIFEST=../.mineru/figure-model.json
CHROMA_DIR=../chroma
HF_HOME=../.hf-cache
HUGGINGFACE_HUB_CACHE=../.hf-cache/hub
TIKTOKEN_CACHE_DIR=../.cache/tiktoken
BACKEND_CORS_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=

# Local pre-trained intent Router managed through llama.cpp.
# Choose ROUTER_PROVIDER=jev to use the configured Jev API instead.
ROUTER_PROVIDER=local
# ROUTER_MANAGED=true starts llama-server from the root launcher; the OpenAI
# transport then points at http://<ROUTER_HOST>:<ROUTER_PORT>/v1 automatically.
ROUTER_MANAGED=true
ROUTER_SERVER_PATH=.tools/llama.cpp/llama-server.exe
ROUTER_GGUF_PATH=models/router/qwen3-1.7b-router-sft-v3/Qwen3-1.7B-Router-SFT-V3-Q4_K_M.gguf
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8089
ROUTER_MODEL=papermind-router-v3
ROUTER_TIMEOUT_SECONDS=60
ROUTER_READY_TIMEOUT_SECONDS=120
# External OpenAI-compatible Router override (takes precedence when set):
ROUTER_API_KEY=
ROUTER_BASE_URL=

# OpenAI-compatible model for Agentic RAG tools and final answers.
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_TIMEOUT_SECONDS=90
AGENT_TOTAL_TIMEOUT_SECONDS=180
AGENT_RETRIEVAL_CANDIDATE_K=20
AGENT_JUDGE_CONTEXT_TOKENS=24000
AGENT_GENERATION_EVIDENCE_TOKENS=12000
AGENT_MAX_ROUNDS=3
AGENT_MAX_TOOL_CALLS=5
# If AGENT_* is unset, the runtime can fall back to the existing OPENAI_* values.

# Jev intent Router. Set the endpoint and model for your key's provider.
# Leave JEV_BASE_URL empty for TypeSafe's direct API.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=10

# Independent OpenAI-compatible model for evaluation judging (all three required).
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=60

# Retrieval and context budgets.
RRF_K=60
BM25_CANDIDATES=20
VECTOR_CANDIDATES_PER_QUERY=15
FUSION_CANDIDATES=20
SIMPLE_EVIDENCE_LIMIT=5
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_WINDOW_TOKENS=128000
CONTEXT_RESERVE_TOKENS=16384
CONTEXT_KEEP_RECENT_TOKENS=20000
CONTEXT_SUMMARY_MAX_TOKENS=2048

# Memory V2: candidate validity, related-memory lookup and vector synchronization
MEMORY_MIN_CONFIDENCE=0.8
MEMORY_RELATED_THRESHOLD=0.75
MEMORY_RELATED_LIMIT=5
MEMORY_SYNC_BATCH_SIZE=20
MEMORY_SEMANTIC_WEIGHT=0.8
MEMORY_RECENCY_WEIGHT=0.2

# DeepSeek example:
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_CHAT_MODEL=deepseek-v4-flash
# Optional stronger model:
# OPENAI_CHAT_MODEL=deepseek-v4-pro
